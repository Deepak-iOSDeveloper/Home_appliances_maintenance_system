# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (default: SQLite — switch to PostgreSQL for production)
# DATABASE_URL=postgres://user:password@localhost:5432/arhis_db

# Redis (required for Celery + Channels in production)
# REDIS_URL=redis://127.0.0.1:6379/0

# OpenAI (optional — system uses simulated responses if absent)
# OPENAI_API_KEY=sk-your-key-here

# Celery
CELERY_TASK_ALWAYS_EAGER=True
